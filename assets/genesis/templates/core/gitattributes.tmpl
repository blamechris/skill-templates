# Text is stored and checked out with LF line endings. Overlays append exceptions below.
* text=auto eol=lf

# Binary assets — never diffed or merged as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp3 binary
*.ogg binary
*.wav binary
*.flac binary
*.m4a binary
*.opus binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.zip binary
@@GITATTRIBUTES_OVERLAYS@@
